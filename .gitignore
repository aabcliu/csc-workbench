# Track only distributable tool source. Ignore local data and unrelated files.
*
!*/
!/.gitignore
!/.dockerignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/RELEASE_MANIFEST.json
!/start.sh
!/start.ps1
!/deploy/Dockerfile
!/deploy/compose.yaml
!/deploy/requirements.lock
!/deploy/smoke_check.py
!/deploy/export-image.sh
!/engine/pyproject.toml
!/engine/csc_tool.py
!/engine/refined_tbfv_tool.py
!/engine/csc_engine/**/*.py
!/engine/java_bridge/pom.xml
!/engine/java_bridge/src/main/java/**/*.java
!/web/pyproject.toml
!/web/backend/app/**/*.py
!/web/frontend/index.html
!/web/frontend/assets/**/*.css
!/web/frontend/assets/**/*.js
!/web/frontend/assets/**/*.mjs
!/web/frontend/assets/vendor/d3.LICENSE
!/schemas/*.schema.json
!/examples/AddLoop.java
!/examples/AddLoop.fsf
!/docs/fsf-format.md
!/docs/sbfl-localization-v1.md
!/licenses/Apache-2.0.txt
!/licenses/TheAlgorithms-MIT.txt
!/benchmarks/EX_CSC/README.md
!/benchmarks/EX_CSC/subjects.json
!/benchmarks/EX_CSC/mutants.jsonl
!/benchmarks/EX_CSC/*/*.java
!/benchmarks/EX_CSC/*/FSF/*_FSF.txt
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/runtime/
**/dataset/
**/target/
**/node_modules/
**/tests/
/engine/csc_engine/failure_localization.py
/engine/csc_engine/failure_localization_aggregate.py
/engine/csc_engine/failure_localization_fold.py
